@article{FOUDA2026107224,
  title = {How Ocean-Going Vessels Respond to Mandatory Dynamic Speed Restriction Zones Aimed at Protecting Whales},
  author = {Fouda, L. and Mayette, A. and Indeck, K.L. and Davies, K.T.A.},
  year = 2026,
  journal = {Marine Policy},
  volume = {193},
  pages = {107224},
  issn = {0308-597X},
  doi = {10.1016/j.marpol.2026.107224},
  abstract = {Dynamic vessel speed restrictions occur when at-risk whales are detected, while permitting normal operating speeds in the absence of detections. No studies have characterised how vessels respond in areas adjacent to speed-restricted zones. We examined ocean-going vessel speeds proximate to four contiguous Dynamic Shipping Zones (DSZs) when one or more were under 10-knot speed limits following North Atlantic right whale (NARW) detections. We analysed the speeds of 11,509 transits by tanker, cargo, and cruise ships across forty-nine active slowdown periods during the 2020--2023 NARW seasons. Ninety-six percent of vessels travelled at {$\leq$}\,10 knots in speed restriction zones (n\,=\,3944). When vessels exceeded an active slowdown speed limit, the average speed was 10.54\,\textpm\,1.19 knots for all ships (n\,=\,124), 10.56\,\textpm\,1.28 knots for cargo ships (n\,=\,98) and 10.45\,\textpm\,0.63 knots for tankers (n\,=\,26). Despite typically travelling at high speeds (15.10\,\textpm\,3.37 knots) no cruise ships transited \textquestiondown\,10 knots during active slowdowns. Vessels in zones contiguous to DSZs with active slowdowns travelled {$\leq$}\,0.5 knots slower than when no active slowdowns were present, regardless of the number of contiguous zones under speed restrictions. Some (3.81},
  keywords = {Anthropogenic threat mitigation,Automatic Information System,Conservation,Dynamic management,North Atlantic right whales,Vessel strike},
  file = {/Users/leilafouda/Zotero/storage/MW6YZIWS/Fouda et al._2026_How ocean-going vessels respond to mandatory dynam.pdf}
}
